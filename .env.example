# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production these are set as Cloudflare secrets (npx wrangler secret put NAME).

MONGODB_URI=
# NEXT_PUBLIC_SITE_URL: leave out locally (defaults to http://localhost:3000); the live address is in .env.production

# Phase 2 — Google login
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
